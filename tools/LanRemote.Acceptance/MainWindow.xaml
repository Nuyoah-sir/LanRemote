<Window x:Class="LanRemote.Acceptance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanRemote M4 两机验收器"
        Width="1000" Height="940" MinWidth="820" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MonoText" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MonoLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Wrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="LanRemote M4 两机验收器" />
            <TextBlock Style="{StaticResource Wrap}" Foreground="#555" FontSize="12"
                       Text="两机须有合格的 RFC1918 同子网地址。被控端显式开始监听；控制端输入对端设备码、访问密钥并选择权限。短码只供人工关联，不能证明远端身份。" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="本机身份与现有网络（只读检查）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,8,2" Text="设备码" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceCodeText"
                                   Style="{StaticResource MonoLabel}" Text="检测中…" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Margin="0,0,8,2" Text="证书指纹" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CertPinText"
                                   Style="{StaticResource MonoLabel}" Text="检测中…" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Margin="0,0,8,2" Text="监听地址" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ListenText"
                                   Style="{StaticResource MonoLabel}" Text="检测中…" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Margin="0,0,8,2" Text="状态" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ReadyText"
                                   Text="检测中…" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Button x:Name="SelfCheckButton" Content="只读检查现有网络"
                                    Click="SelfCheckButton_Click" Margin="0,0,8,0" />
                        </WrapPanel>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Wrap}" Foreground="#666" FontSize="11"
                                       Text="只读检查，不改 DHCP/IP/DNS/路由/热点/ICS/网络类别/防火墙，不提供改网或 Undo 操作；管理员权限或 UAC 确认不予豁免。" />
                            <TextBlock Style="{StaticResource Wrap}" Foreground="#666" FontSize="11"
                                       Text="本地 PASS 仅代表本地检查通过，不代表发现、互通、认证或互联网可用。" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <Border x:Name="RoleBanner" Margin="0,8,0,8" Padding="10,6" CornerRadius="4"
                        Background="#EEE" BorderBrush="#CCC" BorderThickness="1">
                    <TextBlock x:Name="RoleBannerText" FontSize="13" FontWeight="SemiBold"
                               Style="{StaticResource Wrap}" Text="尚未选定角色；同一轮不能切换角色。" />
                </Border>
                <GroupBox Header="这台机器的角色">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="HostButton" Content="被控端：开始 180 秒监听窗口"
                                    Click="HostButton_Click" Margin="0,0,8,0" />
                            <Button x:Name="StopHostButton" Content="提前停止（本轮作废）"
                                    Click="StopHostButton_Click" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock x:Name="HostWindowText" Style="{StaticResource Wrap}" Foreground="#555"
                                   Text="监听成功后计时 180 秒；到时正常清理并按证据结算，不保证 PASS。提前停止为操作员中止。" />
                        <WrapPanel Margin="0,6,0,6">
                            <Button x:Name="ShowKeyButton" Content="确认查看本机访问密钥"
                                    Click="ShowKeyButton_Click" IsEnabled="False" Margin="0,0,8,0" />
                            <Button x:Name="HideKeyButton" Content="隐藏密钥 / 取消查看"
                                    Click="HideKeyButton_Click" IsEnabled="False" />
                        </WrapPanel>
                        <!-- 不用可选择文本框，不提供复制、绑定或轮换入口。 -->
                        <TextBlock x:Name="HostKeyText" Style="{StaticResource MonoLabel}"
                                   FontSize="18" FontWeight="SemiBold" Focusable="False" />
                        <TextBlock x:Name="KeyStatusText" Style="{StaticResource Wrap}" Foreground="#666"
                                   Text="仅 Host 本轮 context 就绪后可查看；确认起最多 15 秒，隐藏、失焦、停机或关窗即清空显示。" />
                        <TextBlock Style="{StaticResource Wrap}" Foreground="#666" FontSize="11"
                                   Text="不复制、不主动轮换、不记日志。原始字节会清零，但 .NET 不可变字符串与 WPF 内部副本不能保证擦净。" />
                        <WrapPanel Margin="0,8,0,4">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="对端设备码" />
                            <TextBox x:Name="PeerCodeBox" Width="125" Style="{StaticResource MonoText}" MaxLength="9" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,8,0" Text="对端访问密钥" />
                            <PasswordBox x:Name="PeerKeyBox" Width="230" MaxLength="128" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,8,0" Text="请求权限" />
                            <ComboBox x:Name="PermissionBox" Width="100" SelectedIndex="1">
                                <ComboBoxItem Content="仅观看" />
                                <ComboBoxItem Content="控制" />
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,4">
                            <Button x:Name="ClientButton" Content="控制端：跑四个场景"
                                    Click="ClientButton_Click" Margin="0,0,8,0" />
                            <Button x:Name="StopClientButton" Content="中止（本轮作废）"
                                    Click="StopClientButton_Click" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock x:Name="ClientPendingText" Style="{StaticResource Wrap}" Foreground="#8B4513" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <!-- 审批不再埋在角色滚动区底部；待批列表有界，仍须明确选择再提交。 -->
        <GroupBox Grid.Row="2" x:Name="ApprovalPanel" Margin="0,6,0,6"
                  Header="被控端本机审批（先选中请求，再点击批准；无操作不会自动批准）">
            <StackPanel>
                <TextBlock x:Name="ApprovalQueueText" Style="{StaticResource Wrap}" FontWeight="SemiBold"
                           Foreground="#8B4513" Text="无待批请求。新请求到达后会在此列出，不会自动批准。" />
                <ListBox x:Name="ApprovalList" MaxHeight="135" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ApprovalList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="来源 IP：" /><Run Text="{Binding Request.RemoteAddress, Mode=OneWay}" />
                                    <Run Text="　自称名称：" /><Run Text="{Binding Request.ClientName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="短码（仅人工关联）：" /><Run Text="{Binding Request.ShortCode, Mode=OneWay}" />
                                    <Run Text="　请求权限：" /><Run Text="{Binding Request.RequestedPermission, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#666">
                                    <Run Text="RequestId：" /><Run Text="{Binding RequestId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="ApproveButton" Content="批准请求权限" IsEnabled="False"
                            Click="ApproveButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="ViewOnlyButton" Content="降为仅观看" IsEnabled="False"
                            Click="ViewOnlyButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="RejectButton" Content="拒绝" IsEnabled="False" Click="RejectButton_Click" />
                </WrapPanel>
                <TextBlock x:Name="ApprovalStatusText" Style="{StaticResource Wrap}" Foreground="#666"
                           Text="名称为对端自称；已提交不等于已授权，Transport 仍需复核期限、断连与最终认证。" />
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="日志（界面仅保留近期内容；复制全部会读取所有运行的完整日志）">
            <TextBox x:Name="LogBox" Style="{StaticResource MonoText}" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </GroupBox>
        <Border Grid.Row="4" x:Name="ResultBanner" Margin="0,8,0,0" Padding="10,6" CornerRadius="4"
                Background="#EEE" BorderBrush="#CCC" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="ResultBannerText" FontSize="13" FontWeight="SemiBold" Style="{StaticResource Wrap}" />
        </Border>
        <WrapPanel Grid.Row="5" Margin="0,8,0,0">
            <Button Content="复制全部日志" Click="CopyLog_Click" Margin="0,0,8,0" />
            <Button Content="打开日志目录" Click="OpenFolder_Click" Margin="0,0,8,0" />
            <TextBlock x:Name="LogPathText" VerticalAlignment="Center" Foreground="#666" FontSize="11"
                       TextWrapping="Wrap" MaxWidth="600" />
        </WrapPanel>
    </Grid>
</Window>
