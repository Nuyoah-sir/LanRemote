<Window x:Class="LanRemote.Acceptance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanRemote M3 两机验收器"
        Width="960" Height="820"
        MinWidth="780" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="MonoText" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MonoLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Wrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="LanRemote M3 两机验收器" />
            <TextBlock Style="{StaticResource Wrap}" Foreground="#555" FontSize="12">
                两台机器各启动本程序：一台选「被控端」先开始监听，另一台选「控制端」填入对端设备码后开始验收。
                若本机还没有进入 192.168.1.0/24，点下面的「准备为 A 机 / B 机」一键配置（会弹一次 UAC），
                不需要自己开 PowerShell。
            </TextBlock>
        </StackPanel>

        <!-- 本机身份 -->
        <GroupBox Grid.Row="1" Header="本机身份与网络（自动检测）">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,2" Text="设备码" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoLabel}"
                           x:Name="DeviceCodeText" Text="检测中…" FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,2" Text="证书指纹" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoLabel}"
                           x:Name="CertPinText" Text="检测中…" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,2" Text="监听地址" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoLabel}"
                           x:Name="ListenText" Text="检测中…" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,2" Text="状态" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ReadyText" Text="检测中…"
                           FontWeight="SemiBold" TextWrapping="Wrap" />

                <!-- 一键准备：本机没进 192.168.1.0/24 时用它。
                     「一键」不等于「静默」——按下去先有确认框，再有 UAC（ADR-024/025/026/035）。 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SelfCheckButton" Content="重新自检"
                            Click="SelfCheckButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="PrepareAButton" Content="准备为 A 机（192.168.1.10）"
                            Click="PrepareAButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="PrepareBButton" Content="准备为 B 机（192.168.1.20）"
                            Click="PrepareBButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                    <Button x:Name="UndoPrepareButton" Content="撤销准备（还原网络设置）"
                            Click="UndoPrepareButton_Click" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Wrap}" Foreground="#666" FontSize="11"
                               Text="准备动作会改本机网络配置（给上网这块网卡再加一个 192.168.1.x 地址、设为「专用」、放行 UDP 45872 与 TCP 45873），需要管理员权限，会弹一次 UAC；原来的地址保持不变。做完随时可以「撤销准备」退回原状。" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 角色锁定横幅：这台机器此刻是哪个角色，必须一眼看到 -->
        <Border Grid.Row="2" x:Name="RoleBanner" Margin="0,0,0,8" Padding="10,6"
                CornerRadius="4" Background="#EEE" BorderBrush="#CCC" BorderThickness="1">
            <TextBlock x:Name="RoleBannerText" FontSize="13" FontWeight="SemiBold"
                       Style="{StaticResource Wrap}"
                       Text="尚未选定角色 —— 先想清楚这台机器扮演哪一个，选定后另一组按钮会锁住。" />
        </Border>

        <!-- 角色 -->
        <GroupBox Grid.Row="3" Header="这台机器的角色">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="HostButton" Content="本机作为被控端（开始监听）"
                            Click="HostButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="StopHostButton" Content="停止监听"
                            Click="StopHostButton_Click" IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="对端设备码" />
                    <TextBox x:Name="PeerCodeBox" Width="140" VerticalAlignment="Center"
                             Style="{StaticResource MonoText}" MaxLength="9" />
                    <Button x:Name="ClientButton" Content="本机作为控制端（跑四个场景）"
                            Click="ClientButton_Click" Margin="8,0,0,0" />
                    <Button x:Name="StopClientButton" Content="中止" IsEnabled="False"
                            Click="StopClientButton_Click" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 日志 -->
        <GroupBox Grid.Row="4" Header="日志（验收证据，请整段拷走）">
            <TextBox x:Name="LogBox" Style="{StaticResource MonoText}"
                     IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </GroupBox>

        <!-- 结论横幅：不放 MessageBox，免得挡住日志 -->
        <Border Grid.Row="5" x:Name="ResultBanner" Margin="0,8,0,0" Padding="10,6"
                CornerRadius="4" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="ResultBannerText" FontSize="13" FontWeight="SemiBold"
                       Style="{StaticResource Wrap}" />
        </Border>

        <!-- 底部 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="复制全部日志" Click="CopyLog_Click" Margin="0,0,8,0" />
            <Button Content="打开日志目录" Click="OpenFolder_Click" Margin="0,0,8,0" />
            <TextBlock VerticalAlignment="Center" Foreground="#666" FontSize="11"
                       x:Name="LogPathText" TextWrapping="Wrap" MaxWidth="560" />
        </StackPanel>
    </Grid>
</Window>
