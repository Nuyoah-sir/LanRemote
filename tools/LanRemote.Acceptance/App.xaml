<Application x:Class="LanRemote.Acceptance.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- 刻意不写 StartupUri：本程序有两个入口——没有参数时开窗口、带 headless 开关时
         跑命令行。StartupUri 会在 OnStartup 返回后无条件建窗口，那条路就没法走了。
         窗口改由 App.OnStartup 显式创建。
         注意：XML 注释里不能出现两个连续的减号，所以上面只能写「headless 开关」而不是
         带前导减号的字面量——这是 MSBuild 的 MC3000，不是笔误。 -->
    <Application.Resources>
        <!-- 中文字体在没有显式指定时会退回不太好看的 fallback，这里钉住。 -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Application.Resources>
</Application>
