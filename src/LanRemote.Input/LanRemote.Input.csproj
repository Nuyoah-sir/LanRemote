<Project Sdk="Microsoft.NET.Sdk">

  <!-- Input：Win32 SendInput 注入、坐标映射、权限闸门。
       普通用户权限运行，不做提权注入（02_PRODUCT_SPEC.md 第 2 节非目标）。M7 施工。
       硬约束：服务端必须在注入前再次校验权限，不能只依赖客户端「不发送」。 -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LanRemote.Input</RootNamespace>
    <AssemblyName>LanRemote.Input</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanRemote.Core\LanRemote.Core.csproj" />
  </ItemGroup>

</Project>
