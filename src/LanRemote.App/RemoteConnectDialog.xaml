<Window x:Class="LanRemote.App.RemoteConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接远端设备" Width="430" Height="260" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closed="OnClosed">
    <StackPanel Margin="20">
        <TextBlock x:Name="TargetText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="请输入远端设备显示的访问密钥；此处绝不使用本机的访问密钥。"
                   TextWrapping="Wrap" Margin="0,10,0,12" />
        <StackPanel x:Name="KeyPanel">
            <PasswordBox x:Name="RemoteKeyBox" MaxLength="80" Margin="0,0,0,12"
                         ToolTip="远端访问密钥（Crockford Base32）" />
            <Button x:Name="ConnectButton" Content="连接（仅查看）" Width="130"
                    HorizontalAlignment="Left" Padding="8,5" Click="OnConnectClick" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="等待输入远端访问密钥。"
                   TextWrapping="Wrap" Margin="0,14,0,0" />
        <Button Content="取消" Width="80" HorizontalAlignment="Right"
                Margin="0,14,0,0" Padding="8,5" Click="OnCancelClick" />
    </StackPanel>
</Window>
