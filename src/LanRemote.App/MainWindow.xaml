<Window x:Class="LanRemote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LanRemote.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="LanRemote"
        Height="640"
        Width="840"
        MinHeight="480"
        MinWidth="720"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        ContentRendered="MainWindow_OnContentRendered"
        Closed="MainWindow_OnClosed">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="LanRemote"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- 本机信息 -->
        <GroupBox Grid.Row="1" Header="本机" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding LocalDeviceName}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="设备码" VerticalAlignment="Center" Margin="0,6,0,0" />
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="复制"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="CopyDeviceCode_OnClick" />
                    <TextBlock Text="{Binding DeviceCode}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="证书指纹" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding CertificateFingerprintShort}"
                           VerticalAlignment="Center"
                           Margin="0,6,0,0"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="访问密钥" VerticalAlignment="Center" Margin="0,6,0,0" />
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="重新生成"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="RegenerateAccessKey_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Content="复制"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="CopyAccessKey_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Content="显示 / 隐藏"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="ToggleAccessKey_OnClick" />
                    <TextBox Text="{Binding AccessKeyDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas"
                             VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="访问密钥只用于连接时的挑战认证，不会通过网络明文发送；本机以 DPAPI（当前用户）加密保存在 secrets.bin，不写入 config.json。"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </Grid>
        </GroupBox>

        <!-- 中间两列：设置 + 设备列表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="主机设置" Padding="12">
                <StackPanel>
                    <CheckBox Content="允许被发现"
                              IsChecked="{Binding AllowDiscovery, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="允许查看屏幕"
                              IsChecked="{Binding AllowViewing, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="允许键鼠控制"
                              IsChecked="{Binding AllowControl, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="陌生控制端首次连接需本机确认"
                              IsChecked="{Binding RequireLocalApproval, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="登录 Windows 后自动启动"
                              IsChecked="{Binding AutoStartOnLogin, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="局域网设备" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="自动发现将在 M2 实现。此处的列表目前为空是有意为之。"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <!-- M2 才会出现真实设备列表。故意不绑定尚不存在的属性，避免绑定错误噪音。 -->
                    <ListBox x:Name="DeviceList" IsEnabled="False">
                        <ListBoxItem Content="（暂无设备 — M2 实现自动发现）" />
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="8,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" />
                <TextBlock Opacity="0.65" Margin="0,4,0,0">
                    <Run Text="数据目录：" />
                    <Run Text="{Binding ConfigRootPath, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Opacity="0.65" Margin="0,2,0,0">
                    <Run Text="密钥文件：" />
                    <Run Text="{Binding SecretsFilePath, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
