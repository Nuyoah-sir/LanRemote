<Window x:Class="LanRemote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LanRemote.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="LanRemote"
        Height="640"
        Width="840"
        MinHeight="480"
        MinWidth="720"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        ContentRendered="MainWindow_OnContentRendered"
        Closing="MainWindow_OnClosing"
        Closed="MainWindow_OnClosed">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="LanRemote"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- 本机信息 -->
        <GroupBox Grid.Row="1" Header="本机" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding LocalDeviceName}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="设备码" VerticalAlignment="Center" Margin="0,6,0,0" />
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="复制"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="CopyDeviceCode_OnClick" />
                    <TextBlock Text="{Binding DeviceCode}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="证书指纹" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding CertificateFingerprintShort}"
                           VerticalAlignment="Center"
                           Margin="0,6,0,0"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="访问密钥" VerticalAlignment="Center" Margin="0,6,0,0" />
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="重新生成"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="RegenerateAccessKey_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Content="复制"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="CopyAccessKey_OnClick" />
                    <Button DockPanel.Dock="Right"
                            Content="显示 / 隐藏"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Click="ToggleAccessKey_OnClick" />
                    <TextBox Text="{Binding AccessKeyDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas"
                             VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="访问密钥只用于连接时的挑战认证，不会通过网络明文发送；本机以 DPAPI（当前用户）加密保存在 secrets.bin，不写入 config.json。"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </Grid>
        </GroupBox>

        <!-- 中间两列：设置 + 设备列表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="主机设置" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <CheckBox Content="允许被发现"
                              IsChecked="{Binding AllowDiscovery, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="允许查看屏幕"
                              IsChecked="{Binding AllowViewing, Mode=TwoWay}"
                              IsEnabled="{Binding HostSettingsReady}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="允许键鼠控制（M5 暂不可用）"
                              IsChecked="{Binding AllowControl, Mode=OneWay}"
                              IsEnabled="False"
                              Margin="0,0,0,8" />
                    <CheckBox Content="本机审批（必需；关闭时仅可勾选修复）"
                              IsChecked="{Binding RequireLocalApproval, Mode=TwoWay}"
                              IsEnabled="{Binding NeedsLocalApprovalRepair}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="本次增强预览：10 FPS / 75%（实验）"
                              IsChecked="{Binding UseClearerPreview, Mode=TwoWay}"
                              ToolTip="默认仍为 5 FPS / 50%；仅下一次开启共享时生效，已在共享需先紧急停止再开启。可能增加 CPU 与局域网带宽占用。"
                              Margin="0,0,0,8" />
                    <CheckBox Content="本次流畅预览：15 FPS / 75%（实验）"
                              IsChecked="{Binding UseSmootherPreview, Mode=TwoWay}"
                              ToolTip="与10 FPS档互斥；已在共享须先紧急停止，完整排空后再显式开启。目标帧率不保证实际达到；CPU与带宽可能更高。"
                              Margin="0,0,0,8" />
                    <CheckBox Content="本次快速预览：20 FPS / 75%（实验）"
                              IsChecked="{Binding UseFastPreview, Mode=TwoWay}"
                              ToolTip="与10/15 FPS档互斥；仅停止共享并完整排空后再显式开启生效。目标帧率不保证实际达到；CPU与带宽可能更高。"
                              Margin="0,0,0,8" />
                    <CheckBox Content="本次高帧率预览：30 FPS / 75%（实验）"
                              IsChecked="{Binding UseThirtyFpsPreview, Mode=TwoWay}"
                              ToolTip="与10/15/20 FPS档互斥；停止共享并完整排空后再显式开启才生效。目标帧率不保证实机达到；CPU、内存与带宽可能增加。"
                              Margin="0,0,0,8" />
                    <CheckBox Content="本次手动缩放 / JPEG 质量（实验）"
                              IsChecked="{Binding UseManualVideoQuality, Mode=TwoWay}"
                              ToolTip="须勾选才覆盖原5FPS/50%或实验档75%与JPEG60；仅下一次显式开启有效，不写入配置。100%与高JPEG质量可能增加内存和带宽。"
                              Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Width="80" ItemsSource="{Binding ManualPreviewScales}"
                                  SelectedItem="{Binding ManualPreviewScale, Mode=TwoWay}"
                                  ToolTip="缩放比例：0.5 / 0.67 / 0.75 / 1.0；须另勾手动画质才生效。" />
                        <TextBlock Text="缩放" VerticalAlignment="Center" Margin="4,0,8,0" />
                        <ComboBox Width="66" ItemsSource="{Binding ManualJpegQualities}"
                                  SelectedItem="{Binding ManualJpegQuality, Mode=TwoWay}"
                                  ToolTip="JPEG质量整数40..85；须另勾手动画质才生效。" />
                        <TextBlock Text="JPEG" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="开启仅查看共享"
                                IsEnabled="{Binding HostSettingsReady}"
                                Click="StartViewOnlySharing_OnClick"
                                Padding="8,4" />
                        <Button Content="紧急停止共享"
                                Click="StopSharing_OnClick"
                                Margin="8,0,0,0"
                                Padding="8,4" />
                    </StackPanel>
                    <CheckBox Content="登录 Windows 后自动启动"
                              IsChecked="{Binding AutoStartOnLogin, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="局域网设备" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="刷新"
                                Padding="14,4"
                                Click="RefreshDevices_OnClick" />
                        <TextBlock Text="同一私有 IPv4 子网内的设备会自动出现。"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                    </DockPanel>

                    <ListBox x:Name="DeviceList"
                             ItemsSource="{Binding DiscoveredDevices}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="●"
                                               Foreground="ForestGreen"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock>
                                            <Run Text="{Binding DeviceName, Mode=OneWay}"
                                                 FontWeight="SemiBold" />
                                            <Run Text="   " />
                                            <Run Text="{Binding DeviceCode, Mode=OneWay}"
                                                 FontFamily="Consolas" />
                                        </TextBlock>
                                        <TextBlock Opacity="0.7">
                                            <Run Text="{Binding Address, Mode=OneWay}" />
                                            <Run Text="  在线" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="仅查看连接"
                                            Click="ConnectViewOnly_OnClick"
                                            Padding="12,2"
                                            VerticalAlignment="Center"
                                            ToolTip="仅查看远端屏幕；请在被控端人工批准，不提供键鼠控制" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="8,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding HostStatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
                <TextBlock Opacity="0.65" Margin="0,4,0,0">
                    <Run Text="数据目录：" />
                    <Run Text="{Binding ConfigRootPath, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Opacity="0.65" Margin="0,2,0,0">
                    <Run Text="密钥文件：" />
                    <Run Text="{Binding SecretsFilePath, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
