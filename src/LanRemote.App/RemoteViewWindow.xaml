<Window x:Class="LanRemote.App.RemoteViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远端屏幕（仅查看）" Width="1024" Height="720"
        MinWidth="480" MinHeight="320" Background="Black"
        Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="#FF232323" LastChildFill="True">
            <Button x:Name="DisconnectButton" DockPanel.Dock="Right" Content="断开"
                    Margin="10,7" Padding="14,5" Click="OnDisconnectClick" />
            <TextBlock x:Name="StatusText" Text="已连接：仅查看，不发送键鼠输入。"
                       Foreground="White" TextWrapping="Wrap"
                       Margin="12,10" VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="1" Background="#FFF3F4F6">
            <TextBlock x:Name="CatalogStatusText" Margin="12,5" Foreground="#FF24292F"
                       Text="等待远端屏幕目录（只读，尚不支持切换屏幕）。" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DisplayCatalogItems" Margin="12,0,12,5">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="#FF24292F" TextWrapping="Wrap">
                                <Run Text="屏幕 " /><Run Text="{Binding Id.Value, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding Width, Mode=OneWay}" />
                                <Run Text=" × " /><Run Text="{Binding Height, Mode=OneWay}" />
                                <Run Text=" · 原点 (" /><Run Text="{Binding X, Mode=OneWay}" />
                                <Run Text=", " /><Run Text="{Binding Y, Mode=OneWay}" /><Run Text=")" />
                                <Run Text=" · 主屏：" /><Run Text="{Binding IsPrimary, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <Border Grid.Row="2" Background="Black" ClipToBounds="True">
            <Image x:Name="RemoteImage" Stretch="Uniform" />
        </Border>
    </Grid>
</Window>
