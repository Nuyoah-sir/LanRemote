<Window x:Class="LanRemote.App.RemoteViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远端屏幕（仅查看）" Width="1024" Height="720"
        MinWidth="480" MinHeight="320" Background="Black"
        Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="#FF232323" LastChildFill="True">
            <Button x:Name="DisconnectButton" DockPanel.Dock="Right" Content="断开"
                    Margin="10,7" Padding="14,5" Click="OnDisconnectClick" />
            <TextBlock x:Name="StatusText" Text="已连接：仅查看，不发送键鼠输入。"
                       Foreground="White" TextWrapping="Wrap"
                       Margin="12,10" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="1" Background="Black" ClipToBounds="True">
            <Image x:Name="RemoteImage" Stretch="Uniform" />
        </Border>
    </Grid>
</Window>
