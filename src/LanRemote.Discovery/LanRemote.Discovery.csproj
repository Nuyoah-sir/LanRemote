<Project Sdk="Microsoft.NET.Sdk">

  <!-- Discovery：UDP 局域网发现、网卡筛选、设备缓存。
       v1 仅 IPv4；只使用私有 RFC1918 网卡（见 04_PROTOCOL_AND_SECURITY.md 第 3 节）。
       M2 施工，M0 仅建立项目边界与占位类型。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LanRemote.Discovery</RootNamespace>
    <AssemblyName>LanRemote.Discovery</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 日志只引用抽象包：具体 provider 由 App 通过 DI 注入。
         Discovery 层因此不知道日志落到哪里，也不存在「顺手把报文原文打进日志」的路径。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanRemote.Core\LanRemote.Core.csproj" />
  </ItemGroup>

</Project>
